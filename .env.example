# Non-secret defaults and placeholder credentials. Populate privately in root .env.
# Real process environment variables take precedence. Never commit the actual .env.
APP_ENVIRONMENT=local

# Meta reasoning: this identifier was verified; changing it requires account verification.
MODEL_API_KEY=replace-with-your-meta-model-api-key
META_MODEL_ID=muse-spark-1.3
# Application bounds 4096-8192; confirm model support before increasing.
META_MAX_COMPLETION_TOKENS=4096
META_TIMEOUT_SECONDS=30
META_MAX_RETRIES=2
META_CONCURRENCY=2
META_INVESTIGATION_BUDGET_SECONDS=240

# Host Java database connection. Compose supplies its own internal database URL.
DB_URL=jdbc:postgresql://localhost:5546/investigator
APP_DB_USERNAME=investigator_app
APP_DB_PASSWORD=replace-with-runtime-database-password
OWNER_DB_USERNAME=investigator_owner
OWNER_DB_PASSWORD=replace-with-migration-database-password
POSTGRES_ADMIN_PASSWORD=replace-with-local-postgresql-admin-password
DB_POOL_MAX_SIZE=6

# Keep the existing database/JWT values when migrating from .local/runtime.env.
JWT_SECRET=replace-with-a-private-random-signing-secret-of-at-least-32-bytes
JWT_ISSUER=ai-policy-investigator
JWT_AUDIENCE=policy-api

# Existing domain/parser safety caps are independent of these HTTP settings.
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=11MB
APP_WORKER_ENABLED=true
APP_INVESTIGATION_WORKER_ENABLED=true

# Optional HOST Java artifacts only; copy verified values from .local/embeddings.env.
# Docker downloads its pinned artifacts automatically and ignores these host settings.
EMBEDDING_MODEL_URI=file:/absolute/path/to/ignored/model.onnx
EMBEDDING_TOKENIZER_URI=file:/absolute/path/to/ignored/tokenizer.json
EMBEDDING_REVISION=replace-with-model-sha256:replace-with-tokenizer-sha256

# These affect only local documentation; production documentation stays denied.
LOCAL_OPENAPI_ENABLED=true
LOCAL_SWAGGER_UI_ENABLED=true
SWAGGER_TRY_IT_OUT_ENABLED=false

# Production injects variables through its runtime and disables dotenv.
# APP_ENVIRONMENT=production
# SPRINGDOTENV_ENABLED=false
