# Install in the frontend repository as .github/workflows/verify.yml, replacing
# its old tests/publish/deploy chain. Backend CI tests and publishes both images.
name: Request application CI
on:
  push:
    branches: [main]
permissions: {}
jobs:
  request-ci:
    runs-on: ubuntu-24.04
    timeout-minutes: 2
    steps:
      - name: Trigger coordinated CI in the backend repository
        env:
          # Dispatch only: backend Contents write. Never use this token for GHCR.
          GH_TOKEN: ${{ secrets.BACKEND_CI_TOKEN }}
        run: |
          if [ -z "$GH_TOKEN" ]; then
            echo '::error::Configure BACKEND_CI_TOKEN with Contents write access to ThierryTe/ai-policy-invetigator for repository_dispatch.'
            exit 1
          fi
          gh api --method POST repos/ThierryTe/ai-policy-invetigator/dispatches -f event_type=frontend-main
